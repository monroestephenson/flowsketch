[Unit]
Description=FlowSketch network telemetry agent
Documentation=https://github.com/monroestephenson/flowsketch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/flowsketch agent --config /etc/flowsketch/agent.yaml
Restart=on-failure
RestartSec=5s
User=flowsketch
Group=flowsketch
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ReadWritePaths=/var/lib/flowsketch

[Install]
WantedBy=multi-user.target
