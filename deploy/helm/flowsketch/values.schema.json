{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "agent", "gateway", "serviceAccounts", "monitoring", "networkPolicy", "queries"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "source", "interface", "ringBlockSizeBytes", "ringBlockCount", "blockRetireTimeoutMs", "fanoutMode", "fanoutGroup", "ebpf", "listenPort", "hostPort", "seed", "flushIntervalMs", "runtimeShards", "runtimeBatchSize", "runtimeShardStrategy", "cpuAffinity", "gatewayPush", "otlp", "updateStrategy", "podAnnotations", "podLabels", "priorityClassName", "nodeSelector", "tolerations", "affinity", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "source": {"enum": ["af_packet", "ebpf"]},
        "interface": {"type": "string", "minLength": 1},
        "ringBlockSizeBytes": {"type": "integer", "enum": [65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216]},
        "ringBlockCount": {"type": "integer", "minimum": 1, "maximum": 16384},
        "blockRetireTimeoutMs": {"type": "integer", "minimum": 1, "maximum": 1000},
        "fanoutMode": {"enum": ["single", "hash", "rx_queue"]},
        "fanoutGroup": {"type": "integer", "minimum": 0, "maximum": 65535},
        "ebpf": {"$ref": "#/definitions/ebpf"},
        "listenPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "hostPort": {"type": "integer", "minimum": 0, "maximum": 65535},
        "seed": {"type": "integer", "minimum": 0},
        "flushIntervalMs": {"type": "integer", "minimum": 10},
        "runtimeShards": {"type": "integer", "minimum": 1, "maximum": 256},
        "runtimeBatchSize": {"type": "integer", "minimum": 1, "maximum": 65536},
        "runtimeShardStrategy": {"enum": ["flow", "round_robin"]},
        "cpuAffinity": {"$ref": "#/definitions/cpuAffinity"},
        "gatewayPush": {"$ref": "#/definitions/gatewayPush"},
        "otlp": {"$ref": "#/definitions/otlp"},
        "updateStrategy": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "priorityClassName": {"type": "string"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "resources": {"type": "object"}
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "listenPort", "seed", "staleAfterMs", "podAnnotations", "podLabels", "priorityClassName", "nodeSelector", "tolerations", "affinity", "service", "podDisruptionBudget", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "const": 1},
        "listenPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "seed": {"type": "integer", "minimum": 0},
        "staleAfterMs": {"type": "integer", "minimum": 1000},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "priorityClassName": {"type": "string"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "annotations"],
          "properties": {
            "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "annotations": {"type": "object"}
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minAvailable": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "gateway"],
      "properties": {
        "agent": {"$ref": "#/definitions/serviceAccount"},
        "gateway": {"$ref": "#/definitions/serviceAccount"}
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "interval", "scrapeTimeout", "labels", "rules"],
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
        "scrapeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
        "labels": {"type": "object"},
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "severity"],
          "properties": {
            "enabled": {"type": "boolean"},
            "severity": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "additionalGatewayIngress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "additionalGatewayIngress": {"type": "array", "items": {"type": "object"}}
      }
    },
    "queries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1},
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9.-]*\\.ya?ml$"}
    }
  },
  "definitions": {
    "cpuAffinity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "captureCpus", "runtimeCpus"],
      "properties": {
        "enabled": {"type": "boolean"},
        "captureCpus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 1023}
        },
        "runtimeCpus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 1023}
        }
      }
    },
    "ebpf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectPath", "ringBufferBytes", "fallbackToAfPacket"],
      "properties": {
        "objectPath": {"type": "string", "minLength": 1},
        "ringBufferBytes": {"type": "integer", "enum": [65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824]},
        "fallbackToAfPacket": {"type": "boolean"}
      }
    },
    "gatewayPush": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "intervalMs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "intervalMs": {"type": "integer", "minimum": 100}
      }
    },
    "otlp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "endpoint", "intervalMs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string"},
        "intervalMs": {"type": "integer", "minimum": 100}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    }
  }
}
